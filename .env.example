# ========================================
# CONFIGURAÇÕES CENTRALIZADAS - BLOGNEWS
# ========================================
# Copie este arquivo para .env.local e configure as variáveis necessárias

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
APP_NAME="BlogNews"
APP_DESCRIPTION="Um blog construído com Next.js"
APP_VERSION="1.0.0"
APP_LANGUAGE="pt-br"
DOMAIN="localhost"

# SEO
SEO_KEYWORDS="aplicação web, blog, tecnologia, programação"
SEO_ROBOTS="index, follow"

# UI/UX
DEFAULT_THEME="dark"
POSTS_PER_PAGE="10"
MAX_IMAGE_SIZE="5242880"

# Performance
CACHE_TTL="3600"
MAX_REQUESTS_PER_MINUTE="100"

# Debug e Logs
ENABLE_DEBUG_LOGS="true"
ENABLE_ERROR_REPORTING="false"

# Segurança
ENABLE_CSRF="true"
ENABLE_CORS="false"
ALLOWED_ORIGINS=""

# ========================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO
# ========================================
NEXTAUTH_SECRET="your-super-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_DEBUG="true"

# Sessão e JWT
SESSION_MAX_AGE="86400"
SESSION_UPDATE_AGE="3600"
JWT_MAX_AGE="86400"

# Cookies
SESSION_COOKIE_NAME="next-auth.session-token"
CSRF_COOKIE_NAME="next-auth.csrf-token"

# Segurança de Login
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION="900"
BCRYPT_SALT_ROUNDS="12"
ENABLE_BRUTE_FORCE_PROTECTION="true"
ENABLE_IP_WHITELIST="false"
ALLOWED_IPS=""

# Logs de Autenticação
AUTH_LOG_LEVEL="info"

# ========================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ========================================
MONGODB_URI="mongodb://localhost:27017/blognews"
DB_NAME="blognews"

# Conexão
DB_MAX_POOL_SIZE="10"
DB_MIN_POOL_SIZE="1"
DB_MAX_IDLE_TIME="30000"
DB_SERVER_SELECTION_TIMEOUT="5000"
DB_SOCKET_TIMEOUT="45000"
DB_CONNECT_TIMEOUT="10000"
DB_HEARTBEAT_FREQUENCY="10000"

# Retry
DB_RETRY_WRITES="true"
DB_RETRY_READS="true"
DB_MAX_RETRIES="3"
DB_RETRY_DELAY="1000"

# Cache
DB_CACHE_ENABLED="true"
DB_CACHE_TTL="300"
DB_CACHE_MAX_SIZE="100"

# Índices
DB_AUTO_CREATE_INDEXES="true"
DB_BACKGROUND_INDEXES="true"

# Monitoramento
DB_MONITORING_ENABLED="false"
DB_LOG_SLOW_QUERIES="false"
DB_SLOW_QUERY_THRESHOLD="1000"

# Backup
DB_BACKUP_ENABLED="false"
DB_BACKUP_INTERVAL="0 2 * * *"
DB_BACKUP_RETENTION="30"

# Coleções
POSTS_COLLECTION="posts"
USERS_COLLECTION="users"
SUBSCRIBERS_COLLECTION="subscribers"
ABOUT_COLLECTION="about"

# Debug
DB_DEBUG="true"
DB_LOG_QUERIES="false"
DB_LOG_CONNECTIONS="false"

# ========================================
# CONFIGURAÇÕES DE EMAIL
# ========================================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_TLS_REJECT_UNAUTHORIZED="true"

# Remetente e Destinatários
EMAIL_FROM_NAME="BlogNews"
ADMIN_EMAIL="admin@blognews.com"
SUPPORT_EMAIL="support@blognews.com"
NOREPLY_EMAIL="noreply@blognews.com"

# Templates
EMAIL_TEMPLATE_BASE_URL="/email-templates"
EMAIL_DEFAULT_LANGUAGE="pt-br"
EMAIL_ENABLE_HTML="true"
EMAIL_ENABLE_TEXT="true"

# Queue (Fila)
EMAIL_QUEUE_ENABLED="false"
EMAIL_MAX_RETRIES="3"
EMAIL_RETRY_DELAY="60000"
EMAIL_BATCH_SIZE="10"
EMAIL_PROCESS_INTERVAL="30000"

# Rate Limiting
EMAIL_RATE_LIMIT_ENABLED="true"
EMAIL_MAX_PER_HOUR="100"
EMAIL_MAX_PER_DAY="1000"

# Notificações
NEWSLETTER_ENABLED="true"
NEWSLETTER_SUBJECT="Nova postagem no BlogNews"
NEWSLETTER_TEMPLATE="newsletter"

CONTACT_EMAIL_ENABLED="true"
CONTACT_EMAIL_SUBJECT="Nova mensagem de contato - BlogNews"
CONTACT_EMAIL_TEMPLATE="contact"
CONTACT_AUTO_REPLY="false"

COMMENT_EMAIL_ENABLED="false"
COMMENT_EMAIL_SUBJECT="Novo comentário no BlogNews"
COMMENT_EMAIL_TEMPLATE="comment"

ADMIN_EMAIL_ENABLED="true"
ADMIN_NEW_USER_EMAIL="false"
ADMIN_NEW_POST_EMAIL="false"
ADMIN_ERROR_EMAIL="true"

# Attachments
EMAIL_ATTACHMENTS_ENABLED="false"
EMAIL_MAX_ATTACHMENT_SIZE="10485760"
EMAIL_ALLOWED_ATTACHMENT_TYPES="pdf,doc,docx,txt,jpg,jpeg,png,gif"

# Debug e Teste
EMAIL_DEBUG="true"
EMAIL_LOG_EMAILS="true"
EMAIL_LOG_ERRORS="true"
EMAIL_SAVE_TO_FILE="false"
EMAIL_TEST_MODE="false"
EMAIL_TEST_INTERCEPT_ADDRESS=""
EMAIL_TEST_LOG_ONLY="false"

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
UPLOAD_ENABLED="true"
MAX_FILE_SIZE="10485760"
MAX_FILES_PER_UPLOAD="5"

# Imagens
IMAGE_UPLOAD_ENABLED="true"
MAX_IMAGE_WIDTH="2048"
MAX_IMAGE_HEIGHT="2048"
IMAGE_QUALITY="85"
ALLOWED_IMAGE_FORMATS="jpg,jpeg,png,gif,webp,svg"

# Redimensionamento
IMAGE_RESIZE_ENABLED="true"
GENERATE_THUMBNAILS="true"
THUMBNAIL_SIZE="150"
SMALL_IMAGE_SIZE="300"
MEDIUM_IMAGE_SIZE="600"
LARGE_IMAGE_SIZE="1200"

# Armazenamento
STORAGE_PROVIDER="imgbb"

# Local Storage
LOCAL_STORAGE_ENABLED="false"
LOCAL_UPLOAD_PATH="./public/uploads"
LOCAL_PUBLIC_PATH="/uploads"
CREATE_UPLOAD_DIRECTORIES="true"

# ImgBB
IMGBB_ENABLED="true"
IMGBB_API_KEY="your-imgbb-api-key"
IMGBB_BASE_URL="https://api.imgbb.com/1/upload"
IMGBB_EXPIRATION=""

# AWS S3
S3_ENABLED="false"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Cloudinary
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="blognews"

# Segurança
VALIDATE_MIME_TYPE="true"
VALIDATE_EXTENSION="true"
ENABLE_ANTIVIRUS="false"
BLOCKED_EXTENSIONS="exe,bat,cmd,com,pif,scr,vbs,js,jar"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp,image/svg+xml,application/pdf,text/plain"

# Processamento
ASYNC_PROCESSING="false"
UPLOAD_QUEUE_NAME="file-processing"
OPTIMIZE_IMAGES="true"
REMOVE_EXIF="true"

# Watermark
WATERMARK_ENABLED="false"
WATERMARK_IMAGE_PATH=""
WATERMARK_POSITION="bottom-right"
WATERMARK_OPACITY="0.5"

# CDN
CDN_ENABLED="false"
CDN_BASE_URL=""
CDN_CACHE_TTL="86400"

# Backup
BACKUP_UPLOADS="false"
BACKUP_PROVIDER="s3"
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION="90"

# Debug
UPLOAD_DEBUG="true"
LOG_UPLOADS="true"
LOG_UPLOAD_ERRORS="true"
UPLOAD_VERBOSE="false"

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================
NODE_ENV="development"

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. Nunca commite este arquivo com dados reais no Git
# 2. Use .env.local para sobrescrever configurações específicas
# 3. Para produção, configure todas as variáveis necessárias
# 4. Mantenha o NEXTAUTH_SECRET seguro e único por ambiente
# 5. Configure adequadamente as credenciais de email e banco de dados
