/* Reset básico */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Variáveis de tema - serão sobrescritas pelo ThemeProvider */
:root {
  /* Cores principais */
  --color-primary: #1976d2;
  --color-primary-hover: #1565c0;
  --color-secondary: #dc004e;
  --color-secondary-hover: #c51162;
  
  /* Cores de fundo */
  --color-background: #ffffff;
  --color-background-secondary: #f8f9fa;
  --color-background-tertiary: #f1f3f4;
  
  /* Cores de texto */
  --color-text: #212529;
  --color-text-secondary: #6c757d;
  --color-text-muted: #adb5bd;
  
  /* Cores de borda */
  --color-border: #dee2e6;
  --color-border-light: #e9ecef;
  --color-border-dark: #ced4da;
  
  /* Cores de estado */
  --color-success: #28a745;
  --color-warning: #ffc107;
  --color-error: #dc3545;
  --color-info: #17a2b8;
  
  /* Cores específicas do blog */
  --color-card-background: #ffffff;
  --color-card-border: #e9ecef;
  --color-header-background: #ffffff;
  --color-sidebar-background: #f8f9fa;
  --color-footer-background: #343a40;
  
  /* Cores de interação */
  --color-hover: #f8f9fa;
  --color-active: #e9ecef;
  --color-focus: #0d6efd;
  
  /* Tipografia */
  --font-family-primary: 'Times New Roman', Times, serif;
  --font-family-secondary: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-family-mono: 'Fira Code', 'Monaco', 'Cascadia Code', monospace;
  
  /* Espaçamentos */
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;
  --spacing-3xl: 4rem;
  --spacing-4xl: 6rem;
  
  /* Border radius */
  --border-radius-sm: 0.125rem;
  --border-radius-md: 0.375rem;
  --border-radius-lg: 0.5rem;
  --border-radius-xl: 0.75rem;
  
  /* Sombras */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

/* Estilos base para modo escuro - aplicados quando data-theme="dark" */
[data-theme="dark"] {
  /* Cores principais */
  --color-primary: #90caf9;
  --color-primary-hover: #64b5f6;
  --color-secondary: #f48fb1;
  --color-secondary-hover: #f06292;
  
  /* Cores de fundo */
  --color-background: #121212;
  --color-background-secondary: #1e1e1e;
  --color-background-tertiary: #2d2d2d;
  
  /* Cores de texto */
  --color-text: #ffffff;
  --color-text-secondary: #b3b3b3;
  --color-text-muted: #757575;
  
  /* Cores de borda */
  --color-border: #424242;
  --color-border-light: #333333;
  --color-border-dark: #616161;
  
  /* Cores de estado */
  --color-success: #4caf50;
  --color-warning: #ff9800;
  --color-error: #f44336;
  --color-info: #2196f3;
  
  /* Cores específicas do blog */
  --color-card-background: #1e1e1e;
  --color-card-border: #333333;
  --color-header-background: #1e1e1e;
  --color-sidebar-background: #121212;
  --color-footer-background: #0d1117;
  
  /* Cores de interação */
  --color-hover: #2d2d2d;
  --color-active: #424242;
  --color-focus: #90caf9;
  
  /* Sombras ajustadas para modo escuro */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.4), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
}

/* Estilos base do HTML e Body */
html, body {
  height: 100%;
  font-family: var(--font-family-primary);
  background-color: var(--color-background);
  color: var(--color-text);
  transition: background-color 0.3s ease, color 0.3s ease;
  scroll-behavior: smooth;
}

/* Reset de elementos */
html {
  line-height: 1.15;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  line-height: 1.6;
}

/* Estilo básico para links */
a {
  color: var(--color-primary);
  text-decoration: none;
  transition: color 0.3s ease;
}

a:hover {
  color: var(--color-primary-hover);
  text-decoration: underline;
}

a:focus {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

/* Estilos para headings */
h1, h2, h3, h4, h5, h6 {
  color: var(--color-text);
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: var(--spacing-md);
}

h1 { font-size: 2.25rem; }
h2 { font-size: 1.875rem; }
h3 { font-size: 1.5rem; }
h4 { font-size: 1.25rem; }
h5 { font-size: 1.125rem; }
h6 { font-size: 1rem; }

/* Paragrafos */
p {
  margin-bottom: var(--spacing-md);
  color: var(--color-text);
}

/* Listas */
ul, ol {
  margin-bottom: var(--spacing-md);
  padding-left: var(--spacing-lg);
}

li {
  margin-bottom: var(--spacing-xs);
}

/* Elementos de formulário base */
input, textarea, select, button {
  font-family: inherit;
  font-size: inherit;
}

button {
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

/* Estilos para contêineres */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: var(--spacing-lg);
}

/* Classes utilitárias */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-muted { color: var(--color-text-muted); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }
.text-info { color: var(--color-info); }

.bg-primary { background-color: var(--color-background); }
.bg-secondary { background-color: var(--color-background-secondary); }
.bg-tertiary { background-color: var(--color-background-tertiary); }

.border { border: 1px solid var(--color-border); }
.border-light { border: 1px solid var(--color-border-light); }
.border-dark { border: 1px solid var(--color-border-dark); }

.rounded-sm { border-radius: var(--border-radius-sm); }
.rounded-md { border-radius: var(--border-radius-md); }
.rounded-lg { border-radius: var(--border-radius-lg); }
.rounded-xl { border-radius: var(--border-radius-xl); }

.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-xl { box-shadow: var(--shadow-xl); }

/* Animações e transições */
.transition {
  transition: all 0.3s ease;
}

.transition-colors {
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}

main {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
  line-height: 1.6;
}

/* Estilo para títulos */
h1, h2, h3 {
  margin: 20px 0;
}

/* Estilo para parágrafos */
p {
  margin-bottom: 20px;
  text-indent: 2em;
}

/* Estilo para botões */
button {
  background-color: #3f51b5;
  color: white;
  border: none;
  padding: 10px 20px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 4px;
  transition: background-color 0.3s;
}

button:hover {
  background-color: #303f9f;
}

button:disabled {
  background-color: #b0bec5;
  cursor: not-allowed;
}

/* Estilo para inputs */
input, textarea {
  width: 100%;
  padding: 10px;
  font-size: 16px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-bottom: 10px;
  transition: border-color 0.3s;
}

input:focus, textarea:focus {
  border-color: #3f51b5;
  outline: none;
}

textarea {
  min-height: 150px;
  resize: vertical;
}

/* Imagens e vídeos responsivos */
img, iframe {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}

.ql-toolbar {
  background-color: #f3f3f3; /* fundo claro para a barra de ferramentas */
}

.ql-toolbar .ql-picker {
  color: #000; /* texto preto para os seletores */
}

.ql-toolbar button {
  color: #000; /* texto preto para os botões */
}

.ql-toolbar button.ql-active {
  color: #007bff; /* texto azul para os botões ativos */
}

/* Estilo específico para o botão de URL */
.ql-toolbar button.ql-insertImageURL {
  color: #000;
}

.ql-toolbar button.ql-insertImageURL.ql-active {
  color: #007bff;
}

/* Ajuste a altura da área de edição */
.ql-container {
  min-height: 300px;
}
